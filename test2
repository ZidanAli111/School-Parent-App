@ExtendWith(MockitoExtension.class)
class AllocationGroupControllerTest {

    @Mock
    private CreateAllocationGroupDomainService createAllocationGroupDomainService;

    @Mock
    private CMDSLoggerUtils loggerUtil;

    @Mock
    private LPRCommonUtils commonUtils;

    @InjectMocks
    private AllocationGroupController allocationGroupController;

    private AllocationGroupV1 allocationGroupV1;
    private AllocationGroupResponseV1 allocationGroupResponseV1;
    private HttpHeaders httpHeaders;
    private static final String TEST_PARTNER_CODE = "test-partner";
    private static final String TEST_CORRELATION_ID = "b2885ba0-cb85-4629-a0af-1db25f3d7154";

    @BeforeEach
    void setUp() {
        allocationGroupV1 = new AllocationGroupV1();
        allocationGroupV1.setAllocationGroupName("Test Group");
        allocationGroupV1.setEffectiveFromDate(LocalDate.parse("2025-03-20"));
        allocationGroupV1.setEffectiveToDate(LocalDate.parse("2025-06-14"));

        allocationGroupResponseV1 = new AllocationGroupResponseV1();
        allocationGroupResponseV1.setAllocationGroupUuid(UUID.fromString("b2885ba0-cb85-4629-a0af-1db25f3d7154"));
        allocationGroupResponseV1.setAllocationGroupId(1);
        allocationGroupResponseV1.setAllocationGroupName("Test Group");
        allocationGroupResponseV1.setEffectiveFromDate(LocalDate.parse("2025-03-20"));
        allocationGroupResponseV1.setEffectiveToDate(LocalDate.parse("2025-06-14"));

        httpHeaders = new HttpHeaders();
        httpHeaders.add(X_ACCESS_TOKEN, "valid-token");
        httpHeaders.add(AllocationGroupConstants.CORRELATION_ID, TEST_CORRELATION_ID);
    }

    @Test
    void createAllocationGroup_ShouldReturnSuccessResponse_WhenValidRequest() throws RbacValidationException {
        // Arrange
        when(createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, httpHeaders))
            .thenReturn(allocationGroupResponseV1);
        when(commonUtils.getPartnerCode("valid-token")).thenReturn(TEST_PARTNER_CODE);

        // Act
        ResponseEntity<AllocationGroupResponseV1> response = 
            allocationGroupController.createAllocationGroup(allocationGroupV1, httpHeaders);

        // Assert
        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(allocationGroupResponseV1, response.getBody());

        // Verify logging and context initialization
        verify(loggerUtil).initializeMDCContext(
            anyString(), 
            eq("Allocation Group Unit"), 
            eq(TEST_CORRELATION_ID)
        );
        verify(commonUtils).initializeHeaderContext(httpHeaders);

        // Verify header context was properly set
        CMDSHeaderContext headerContext = ThreadLocalHeaderContext.getContext();
        assertNotNull(headerContext);
        assertEquals(UUID.fromString(TEST_CORRELATION_ID), headerContext.getCorrelationId());
        assertEquals(TEST_PARTNER_CODE, headerContext.getPartnerCode());

        // Verify audit context was properly set
        CMDSAuditContext auditContext = ThreadLocalAuditContext.getContext();
        assertNotNull(auditContext);
        assertEquals(headerContext.getCorrelationId(), auditContext.getCausedByCorrelationId());
    }

    @Test
    void createAllocationGroup_ShouldThrowRbacException_WhenInvalidToken() throws RbacValidationException {
        // Arrange
        when(commonUtils.getPartnerCode("valid-token"))
            .thenThrow(new RbacValidationException("Invalid token"));

        // Act & Assert
        assertThrows(RbacValidationException.class, () -> 
            allocationGroupController.createAllocationGroup(allocationGroupV1, httpHeaders));

        verify(commonUtils).initializeHeaderContext(httpHeaders);
        verify(loggerUtil).initializeMDCContext(anyString(), anyString(), anyString());
    }

    @Test
    void createAllocationGroup_ShouldThrowException_WhenServiceFails() throws RbacValidationException {
        // Arrange
        when(commonUtils.getPartnerCode("valid-token")).thenReturn(TEST_PARTNER_CODE);
        when(createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, httpHeaders))
            .thenThrow(new RuntimeException("Service failure"));

        // Act & Assert
        assertThrows(RuntimeException.class, () -> 
            allocationGroupController.createAllocationGroup(allocationGroupV1, httpHeaders));

        verify(createAllocationGroupDomainService).addAllocationGroup(allocationGroupV1, httpHeaders);
    }

    @Test
    void createAllocationGroup_ShouldValidateHeaders_WhenMissingRequiredHeaders() {
        // Arrange - empty headers
        HttpHeaders emptyHeaders = new HttpHeaders();

        // Act & Assert
        assertThrows(NullPointerException.class, () -> 
            allocationGroupController.createAllocationGroup(allocationGroupV1, emptyHeaders));

        verify(loggerUtil, never()).initializeMDCContext(anyString(), anyString(), anyString());
    }

    @Test
    void createAllocationGroup_ShouldValidateRequest_WhenNullRequestBody() {
        // Act & Assert
        assertThrows(NullPointerException.class, () -> 
            allocationGroupController.createAllocationGroup(null, httpHeaders));

        verify(loggerUtil, never()).initializeMDCContext(anyString(), anyString(), anyString());
    }

    @AfterEach
    void tearDown() {
        // Clear thread-local contexts to avoid test pollution
        ThreadLocalHeaderContext.clearContext();
        ThreadLocalAuditContext.clearContext();
    }
}
