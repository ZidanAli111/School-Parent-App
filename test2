package com.ielts.cmds.lpr.infrastructure.exception;

import com.ielts.cmds.ms.lpr_mx.BaseEventErrorsErrorListInner;
import com.ielts.cmds.v2.common.constants.CMDSConstants;
import jakarta.validation.ConstraintViolation;
import jakarta.validation.Path;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.Collections;
import java.util.HashMap;
import java.util.List;
import java.util.Map;
import java.util.Set;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class CMDSLPRErrorResolverTest {

    private CMDSLPRErrorResolver<Object> errorResolver;
    private Map<String, String> errorCodeMapper;

    @Mock
    private ConstraintViolation<Object> constraintViolation1;
    
    @Mock
    private ConstraintViolation<Object> constraintViolation2;
    
    @Mock
    private Path path;

    @BeforeEach
    void setUp() {
        errorCodeMapper = new HashMap<>();
        errorCodeMapper.put("E100", "Sample error message");
        errorCodeMapper.put("E100" + CMDSConstants.TITLE, "Error Title");
        errorCodeMapper.put("W200", "Sample warning message");
        errorCodeMapper.put("W200" + CMDSConstants.TITLE, "Warning Title");
        errorCodeMapper.put("V300", "Sample validation message");
        errorCodeMapper.put("V300" + CMDSConstants.TITLE, "Validation Title");
        
        errorResolver = new CMDSLPRErrorResolver<>(errorCodeMapper);
    }

    @Test
    void constructor_ShouldInitializeUnmodifiableErrorCodeMapper() {
        assertThrows(UnsupportedOperationException.class, 
            () -> errorResolver.getErrorCodeMapper().put("newKey", "newValue"));
    }

    @Test
    void populateErrorResponse_ShouldReturnEmptyList_WhenNoViolations() {
        List<BaseEventErrorsErrorListInner> result = 
            errorResolver.populatErrorResponse(Collections.emptySet(), "TestInterface");
        
        assertTrue(result.isEmpty());
    }

    @Test
    void populateErrorResponse_ShouldCreateErrorDescriptions_ForEachViolation() {
        // Mock violation 1 (Error type)
        when(constraintViolation1.getMessage()).thenReturn("E100");
        when(constraintViolation1.getPropertyPath()).thenReturn(path);
        when(path.toString()).thenReturn("field1");
        
        // Mock violation 2 (Warning type)
        when(constraintViolation2.getMessage()).thenReturn("W200");
        when(constraintViolation2.getPropertyPath()).thenReturn(path);
        when(path.toString()).thenReturn("field2");

        Set<ConstraintViolation<Object>> violations = Set.of(constraintViolation1, constraintViolation2);
        
        List<BaseEventErrorsErrorListInner> result = 
            errorResolver.populatErrorResponse(violations, "TestInterface");
        
        assertEquals(2, result.size());
        
        // Verify first error
        BaseEventErrorsErrorListInner error1 = result.get(0);
        assertEquals("TestInterface", error1.getInterface());
        assertEquals("E100", error1.getErrorCode());
        assertEquals(BaseEventErrorsErrorListInner.TypeEnum.ERROR, error1.getType());
        assertEquals("Sample error message", error1.getMessage());
        assertEquals("Error Title", error1.getTitle());
        
        // Verify second error
        BaseEventErrorsErrorListInner error2 = result.get(1);
        assertEquals("TestInterface", error2.getInterface());
        assertEquals("W200", error2.getErrorCode());
        assertEquals(BaseEventErrorsErrorListInner.TypeEnum.WARNING, error2.getType());
        assertEquals("Sample warning message", error2.getMessage());
        assertEquals("Warning Title", error2.getTitle());
    }

    @Test
    void getErrorTypeFromErrorCode_ShouldReturnCorrectType() {
        assertEquals(BaseEventErrorsErrorListInner.TypeEnum.ERROR, 
            CMDSLPRErrorResolver.getErrorTypeFromErrorCode('E'));
        assertEquals(BaseEventErrorsErrorListInner.TypeEnum.WARNING, 
            CMDSLPRErrorResolver.getErrorTypeFromErrorCode('W'));
        assertEquals(BaseEventErrorsErrorListInner.TypeEnum.VALIDATION, 
            CMDSLPRErrorResolver.getErrorTypeFromErrorCode('V'));
    }

    @Test
    void getErrorTypeFromErrorCode_ShouldReturnNull_ForUnknownCode() {
        assertNull(CMDSLPRErrorResolver.getErrorTypeFromErrorCode('X'));
    }

    @Test
    void getErrorDescription_ShouldHandleMissingTitleKey() {
        // Setup a violation with message that doesn't have a title mapping
        when(constraintViolation1.getMessage()).thenReturn("E999"); // Not in our errorCodeMapper
        when(constraintViolation1.getPropertyPath()).thenReturn(path);
        when(path.toString()).thenReturn("field1");

        BaseEventErrorsErrorListInner result = 
            errorResolver.getErrorDescription(constraintViolation1, "TestInterface");
        
        assertEquals("TestInterface", result.getInterface());
        assertEquals("E999", result.getErrorCode());
        assertEquals(BaseEventErrorsErrorListInner.TypeEnum.ERROR, result.getType());
        assertNull(result.getMessage()); // Not in our errorCodeMapper
        assertNull(result.getTitle());   // Not in our errorCodeMapper
    }

    @Test
    void getErrorDescription_ShouldHandleNullPropertyPath() {
        when(constraintViolation1.getMessage()).thenReturn("V300");
        when(constraintViolation1.getPropertyPath()).thenReturn(null);

        BaseEventErrorsErrorListInner result = 
            errorResolver.getErrorDescription(constraintViolation1, "TestInterface");
        
        assertEquals("TestInterface", result.getInterface());
        assertEquals("V300", result.getErrorCode());
        assertEquals(BaseEventErrorsErrorListInner.TypeEnum.VALIDATION, result.getType());
        assertEquals("Sample validation message", result.getMessage());
        assertEquals("Validation Title", result.getTitle());
    }
}
