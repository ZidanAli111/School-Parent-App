@ExtendWith(MockitoExtension.class)
class CreateAllocationGroupDomainServiceTest {

    @InjectMocks
    private CreateAllocationGroupDomainService createAllocationGroupDomainService;

    @Mock
    private AllocationGroupMapper allocationGroupMapper;

    @Mock
    private LPRCommonUtils lprCommonUtils;

    @Mock
    private RBACService rbacService;

    @Mock
    private ApplicationEventPublisher eventPublisher;

    @Mock
    private ObjectMapper objectMapper;

    @Mock
    private CMDSThreadLocalContextService cmdsThreadLocalContextService;

    @Mock
    private AllocationGroupRepository allocationGroupRepository;

    private AllocationGroup allocationGroup;
    private AllocationGroupV1 allocationGroupV1;
    private AllocationGroupResponseV1 allocationGroupResponseV1;
    private AllocationGroupChanged allocationGroupChanged;
    private HttpHeaders httpHeaders;

    @BeforeEach
    void setUp() {
        httpHeaders = new HttpHeaders();
        httpHeaders.add("x-access-token", "valid-token");

        // Initialize service with all mocked dependencies
        createAllocationGroupDomainService = new CreateAllocationGroupDomainService(
                eventPublisher,
                objectMapper,
                cmdsThreadLocalContextService,
                rbacService, // Add rbacService
                lprCommonUtils, // Add lprCommonUtils
                allocationGroupMapper, // Add allocationGroupMapper
                allocationGroupRepository // Add allocationGroupRepository
        );

        // Initialize test data
        allocationGroup = AllocationGroup.builder()
                .allocationGroupUuid(UUID.fromString("b2885ba0-cb85-4629-a0af-1db25f3d7154"))
                .allocationGroupId(1)
                .allocationGroupName("Test Group")
                .effectiveFromDate(LocalDate.parse("2025-03-20"))
                .effectiveToDate(LocalDate.parse("2025-06-14"))
                .build();

        allocationGroupV1 = new AllocationGroupV1();
        allocationGroupV1.setAllocationGroupName("Test Group");
        allocationGroupV1.setEffectiveFromDate(LocalDate.parse("2025-03-20"));
        allocationGroupV1.setEffectiveToDate(LocalDate.parse("2025-06-14"));

        allocationGroupResponseV1 = new AllocationGroupResponseV1();
        allocationGroupResponseV1.setAllocationGroupUuid(UUID.fromString("b2885ba0-cb85-4629-a0af-1db25f3d7154"));
        allocationGroupResponseV1.setAllocationGroupId(1);
        allocationGroupResponseV1.setAllocationGroupName("Test Group");
        allocationGroupResponseV1.setEffectiveFromDate(LocalDate.parse("2025-03-20"));
        allocationGroupResponseV1.setEffectiveToDate(LocalDate.parse("2025-06-14"));
    }

    @Test
    public void createAllocationGroup_givenAuthorizedUser() throws RbacValidationException, UnauthorizedException {
        when(rbacService.isAuthorised(anyString(), eq(AllocationGroupConstants.AG_CREATE))).thenReturn(true);
        when(allocationGroupMapper.mapRequestToEntity(allocationGroupV1)).thenReturn(allocationGroup);
        when(allocationGroupRepository.save(allocationGroup)).thenReturn(allocationGroup);
        when(allocationGroupMapper.mapAllocationGroupV1ToAllocationGroup(allocationGroup)).thenReturn(allocationGroupResponseV1);
        when(allocationGroupMapper.mapAllocationGroupChangeEvent(allocationGroupResponseV1)).thenReturn(allocationGroupChanged);

        AllocationGroupResponseV1 response = createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, httpHeaders);

        assertNotNull(response);
        assertEquals(allocationGroupResponseV1, response);
        assertEquals(allocationGroupResponseV1.getAllocationGroupUuid(), response.getAllocationGroupUuid());
        assertEquals(allocationGroupResponseV1.getAllocationGroupId(), response.getAllocationGroupId());
        assertEquals(allocationGroupResponseV1.getAllocationGroupName(), response.getAllocationGroupName());
        assertEquals(allocationGroupResponseV1.getEffectiveFromDate(), response.getEffectiveFromDate());
        assertEquals(allocationGroupResponseV1.getEffectiveToDate(), response.getEffectiveToDate());

        verify(rbacService, times(1)).isAuthorised(anyString(), eq(AllocationGroupConstants.AG_CREATE));
        verify(allocationGroupMapper).mapRequestToEntity(allocationGroupV1);
        verify(allocationGroupRepository).save(allocationGroup);
        verify(allocationGroupMapper).mapAllocationGroupV1ToAllocationGroup(allocationGroup);
        verify(allocationGroupMapper).mapAllocationGroupChangeEvent(allocationGroupResponseV1);
        verify(lprCommonUtils).buildHeader("AllocationGroupChanged");
        verify(createAllocationGroupDomainService).publishEvent(allocationGroupChanged);
    }

    @Test
    public void createAllocationGroup_givenUnauthorizedUser() throws RbacValidationException {
        when(rbacService.isAuthorised(anyString(), eq(AllocationGroupConstants.AG_CREATE))).thenReturn(false);

        Set<ConstraintViolation<Object>> violations = Collections.emptySet();
        when(lprCommonUtils.getSetforNullViolationofEventBody("V3072",
                AllocationGroupConstants.UNAUTHORIZED_TO_CREATE_ALLOCATION_GROUP)).thenReturn(violations);

        CMDSLPRErrorResponse errorResponse = new CMDSLPRErrorResponse();
        when(allocationGroupMapper.generateLPRErrorResponse(eq(violations), eq(AllocationGroupConstants.AG_CREATE))).thenReturn(errorResponse);

        UnauthorizedException unAuthorizedException = assertThrows(UnauthorizedException.class, () -> {
            createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, httpHeaders);
        });

        assertEquals(AllocationGroupConstants.CREATE_ALLOCATION_GROUP_PERMISSION_FAILURE, unAuthorizedException.getMessage());
        verify(rbacService, times(1)).isAuthorised(anyString(), eq(AllocationGroupConstants.AG_CREATE));
        verify(lprCommonUtils, times(1)).getSetforNullViolationofEventBody("V3072",
                AllocationGroupConstants.UNAUTHORIZED_TO_CREATE_ALLOCATION_GROUP);
        verify(allocationGroupMapper, times(1)).generateLPRErrorResponse(eq(violations),
                eq(AllocationGroupConstants.AG_CREATE));
    }
}
