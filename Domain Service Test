package com.ielts.cmds.lpr.domain;

import com.ielts.cmds.api.evt_228.AllocationGroupChanged;
import com.ielts.cmds.lpr.common.model.AllocationGroup;
import com.ielts.cmds.lpr.common.repository.AllocationGroupRepository;
import com.ielts.cmds.lpr.infrastructure.exception.CMDSLPRErrorResponse;
import com.ielts.cmds.lpr.infrastructure.exception.UnauthorizedException;
import com.ielts.cmds.lpr.infrastructure.mapper.AllocationGroupMapper;
import com.ielts.cmds.lpr.infrastructure.utils.AllocationGroupConstants;
import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;
import com.ielts.cmds.v2.rbac.api.service.RBACService;
import com.ielts.cmds.v2.rbac.api.service.exception.RbacValidationException;
import com.ielts.cmds.v2.serialization.application.utils.CMDSThreadLocalContextService;
import com.ielts.cmds.v2.serialization.domain.AbstractCMDSDomainService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.context.ApplicationEventPublisher;
import org.springframework.http.HttpHeaders;
import com.fasterxml.jackson.databind.ObjectMapper;
import java.util.Optional;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class CreateAllocationGroupDomainServiceTest {

    @InjectMocks
    private CreateAllocationGroupDomainService createAllocationGroupDomainService;

    @Mock
    private RBACService rbacService;

    @Mock
    private LPRCommonUtils lprCommonUtils;

    @Mock
    private AllocationGroupMapper allocationGroupMapper;

    @Mock
    private AllocationGroupRepository allocationGroupRepository;

    @Mock
    private ApplicationEventPublisher publisher;

    @Mock
    private ObjectMapper objectMapper;

    @Mock
    private CMDSThreadLocalContextService cmdsThreadLocalContextService;

    private HttpHeaders requestHeaders;
    private AllocationGroupV1 allocationGroupReqBody;
    private AllocationGroupResponseV1 allocationGroupResponseV1;
    private AllocationGroup allocationGroup;

    @BeforeEach
    void setUp() {
        createAllocationGroupDomainService = new CreateAllocationGroupDomainService(publisher, objectMapper, cmdsThreadLocalContextService);
        createAllocationGroupDomainService.rbacService = rbacService;
        createAllocationGroupDomainService.lprCommonUtils = lprCommonUtils;
        createAllocationGroupDomainService.allocationGroupMapper = allocationGroupMapper;
        createAllocationGroupDomainService.allocationGroupRepository = allocationGroupRepository;
        
        requestHeaders = new HttpHeaders();
        requestHeaders.add("x-access-token", "valid-token");
        
        allocationGroupReqBody = new AllocationGroupV1();
        allocationGroupReqBody.setAllocationGroupName("Test Group");
        
        allocationGroup = new AllocationGroup();
        allocationGroup.setAllocationGroupName("Test Group");
        
        allocationGroupResponseV1 = new AllocationGroupResponseV1();
        allocationGroupResponseV1.setAllocationGroupName("Test Group");
    }

    @Test
    void shouldCreateAllocationGroupSuccessfully() throws RbacValidationException, UnauthorizedException {
        when(rbacService.isAuthorised(anyString(), eq(AllocationGroupConstants.AG_CREATE))).thenReturn(true);
        when(allocationGroupMapper.mapRequestToEntity(allocationGroupReqBody)).thenReturn(allocationGroup);
        when(allocationGroupRepository.save(allocationGroup)).thenReturn(allocationGroup);
        when(allocationGroupMapper.mapAllocationGroupToResponse(allocationGroup)).thenReturn(allocationGroupResponseV1);
        
        AllocationGroupResponseV1 response = createAllocationGroupDomainService.addAllocationGroup(allocationGroupReqBody, requestHeaders);
        
        assertNotNull(response);
        assertEquals("Test Group", response.getAllocationGroupName());
    }

    @Test
    void shouldThrowUnauthorizedExceptionWhenNotAuthorized() {
        when(rbacService.isAuthorised(anyString(), eq(AllocationGroupConstants.AG_CREATE))).thenReturn(false);
        
        UnauthorizedException thrown = assertThrows(UnauthorizedException.class, () -> {
            createAllocationGroupDomainService.addAllocationGroup(allocationGroupReqBody, requestHeaders);
        });
        
        assertEquals("You do not have permission to create allocation group", thrown.getMessage());
    }
}
