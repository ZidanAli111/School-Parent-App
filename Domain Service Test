package com.ielts.cmds.lpr.domain;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.ielts.cmds.api.evt_228.AllocationGroupChanged;
import com.ielts.cmds.lpr.common.model.AllocationGroup;
import com.ielts.cmds.lpr.common.repository.AllocationGroupRepository;
import com.ielts.cmds.lpr.infrastructure.exception.CMDSLPRErrorResponse;
import com.ielts.cmds.lpr.infrastructure.exception.UnauthorizedException;
import com.ielts.cmds.lpr.infrastructure.mapper.AllocationGroupMapper;
import com.ielts.cmds.lpr.infrastructure.utils.AllocationGroupConstants;
import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;
import com.ielts.cmds.v2.rbac.api.service.RBACService;
import com.ielts.cmds.v2.rbac.api.service.exception.RbacValidationException;
import com.ielts.cmds.v2.serialization.application.utils.CMDSThreadLocalContextService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.context.ApplicationEventPublisher;
import org.springframework.http.HttpHeaders;

import java.util.Set;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class CreateAllocationGroupDomainServiceTest {

    @InjectMocks
    private CreateAllocationGroupDomainService createAllocationGroupDomainService;

    @Mock
    private RBACService rbacService;
    
    @Mock
    private LPRCommonUtils lprCommonUtils;
    
    @Mock
    private AllocationGroupMapper allocationGroupMapper;
    
    @Mock
    private AllocationGroupRepository allocationGroupRepository;
    
    @Mock
    private ApplicationEventPublisher publisher;
    
    @Mock
    private ObjectMapper objectMapper;
    
    @Mock
    private CMDSThreadLocalContextService cmdsThreadLocalContextService;
    
    private HttpHeaders requestHeaders;
    
    @BeforeEach
    void setUp() {
        createAllocationGroupDomainService = new CreateAllocationGroupDomainService(
                publisher, objectMapper, cmdsThreadLocalContextService);
        
        requestHeaders = new HttpHeaders();
        requestHeaders.set("x-access-token", "test-token");
    }
    
    @Test
    void addAllocationGroup_Success() throws RbacValidationException, UnauthorizedException {
        AllocationGroupV1 request = new AllocationGroupV1();
        AllocationGroup entity = new AllocationGroup();
        AllocationGroupResponseV1 response = new AllocationGroupResponseV1();
        AllocationGroupChanged event = new AllocationGroupChanged();

        when(rbacService.isAuthorised("test-token", AllocationGroupConstants.AG_CREATE)).thenReturn(true);
        when(allocationGroupMapper.mapRequestToEntity(request)).thenReturn(entity);
        when(allocationGroupRepository.save(entity)).thenReturn(entity);
        when(allocationGroupMapper.mapAllocationGroupToResponse(entity)).thenReturn(response);
        when(allocationGroupMapper.mapAllocationGroupChangeEvent(response)).thenReturn(event);

        AllocationGroupResponseV1 result = createAllocationGroupDomainService.addAllocationGroup(request, requestHeaders);

        assertNotNull(result);
        verify(allocationGroupRepository, times(1)).save(entity);
        verify(publisher, times(1)).publishEvent(event);
    }
    
    @Test
    void addAllocationGroup_UnauthorizedException() throws RbacValidationException {
        when(rbacService.isAuthorised("test-token", AllocationGroupConstants.AG_CREATE)).thenReturn(false);
        when(lprCommonUtils.getSetforNullViolationofEventBody(any(), any())).thenReturn(Set.of());
        when(allocationGroupMapper.generateLPRErrorResponse(any(), any())).thenReturn(new CMDSLPRErrorResponse());
        
        UnauthorizedException exception = assertThrows(UnauthorizedException.class, () ->
                createAllocationGroupDomainService.addAllocationGroup(new AllocationGroupV1(), requestHeaders));
        
        assertNotNull(exception);
        verify(allocationGroupRepository, never()).save(any());
        verify(publisher, never()).publishEvent(any());
    }
}
