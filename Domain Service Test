package com.ielts.cmds.lpr.domain;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.ielts.cmds.api.evt_228.AllocationGroupChanged;
import com.ielts.cmds.lpr.common.model.AllocationGroup;
import com.ielts.cmds.lpr.common.repository.AllocationGroupRepository;
import com.ielts.cmds.lpr.infrastructure.exception.CMDSLPRErrorResponse;
import com.ielts.cmds.lpr.infrastructure.exception.UnauthorizedException;
import com.ielts.cmds.lpr.infrastructure.mapper.AllocationGroupMapper;
import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;
import com.ielts.cmds.v2.rbac.api.service.RBACService;
import com.ielts.cmds.v2.rbac.api.service.exception.RbacValidationException;
import com.ielts.cmds.v2.serialization.application.utils.CMDSThreadLocalContextService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.context.ApplicationEventPublisher;
import org.springframework.http.HttpHeaders;
import java.util.Collections;
import java.util.Optional;
import java.util.Set;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class CreateAllocationGroupDomainServiceTest {

    @Mock
    private RBACService rbacService;

    @Mock
    private LPRCommonUtils lprCommonUtils;

    @Mock
    private AllocationGroupMapper allocationGroupMapper;

    @Mock
    private AllocationGroupRepository allocationGroupRepository;

    @Mock
    private ApplicationEventPublisher publisher;

    @Mock
    private ObjectMapper objectMapper;

    @Mock
    private CMDSThreadLocalContextService cmdsThreadLocalContextService;

    @InjectMocks
    private CreateAllocationGroupDomainService createAllocationGroupDomainService;

    private HttpHeaders requestHeaders;
    private AllocationGroupV1 allocationGroupV1;
    private AllocationGroup allocationGroup;
    private AllocationGroupResponseV1 allocationGroupResponseV1;
    private AllocationGroupChanged allocationGroupChanged;

    @BeforeEach
    void setUp() {
        requestHeaders = new HttpHeaders();
        requestHeaders.add("x-access-token", "valid-token");

        allocationGroupV1 = new AllocationGroupV1();
        allocationGroupV1.setAllocationGroupName("Test Group");
        allocationGroupV1.setEffectiveFromDate("2024-03-01");
        allocationGroupV1.setEffectiveToDate("2025-03-01");

        allocationGroup = new AllocationGroup();
        allocationGroup.setAllocationGroupName("Test Group");

        allocationGroupResponseV1 = new AllocationGroupResponseV1();
        allocationGroupResponseV1.setAllocationGroupUuid("123e4567-e89b-12d3-a456-426614174000");
        allocationGroupResponseV1.setAllocationGroupName("Test Group");

        allocationGroupChanged = new AllocationGroupChanged();
        allocationGroupChanged.setAllocationGroupUuid("123e4567-e89b-12d3-a456-426614174000");
    }

    @Test
    void addAllocationGroup_Success() throws RbacValidationException {
        // Mock authorization check
        when(rbacService.isAuthorised("valid-token", "AG_CREATE")).thenReturn(true);
        
        // Mock mapping and repository save
        when(allocationGroupMapper.mapRequestToEntity(allocationGroupV1)).thenReturn(allocationGroup);
        when(allocationGroupRepository.save(allocationGroup)).thenReturn(allocationGroup);
        when(allocationGroupMapper.mapAllocationGroupV1ToAllocationGroup(allocationGroup)).thenReturn(allocationGroupResponseV1);
        when(allocationGroupMapper.mapAllocationGroupChangeEvent(allocationGroupResponseV1)).thenReturn(allocationGroupChanged);

        // Execute the method
        AllocationGroupResponseV1 response = createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, requestHeaders);

        // Assertions
        assertNotNull(response);
        assertEquals("123e4567-e89b-12d3-a456-426614174000", response.getAllocationGroupUuid());
        assertEquals("Test Group", response.getAllocationGroupName());

        // Verify method calls
        verify(rbacService, times(1)).isAuthorised("valid-token", "AG_CREATE");
        verify(allocationGroupRepository, times(1)).save(any(AllocationGroup.class));
        verify(publisher, times(1)).publishEvent(any(AllocationGroupChanged.class));
    }

    @Test
    void addAllocationGroup_UnauthorizedException() {
        // Mock authorization check failure
        when(rbacService.isAuthorised("valid-token", "AG_CREATE")).thenReturn(false);
        when(lprCommonUtils.getSetforNullViolationofEventBody("V3072", "UnauthorisedToCreateAllocationGroup"))
                .thenReturn(Collections.emptySet());

        CMDSLPRErrorResponse errorResponse = new CMDSLPRErrorResponse();
        when(allocationGroupMapper.generateLPRErrorResponse(any(Set.class), eq("AG_CREATE")))
                .thenReturn(errorResponse);

        // Exception Assertion
        UnauthorizedException exception = assertThrows(UnauthorizedException.class, () ->
                createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, requestHeaders));

        assertNotNull(exception);
        verify(rbacService, times(1)).isAuthorised("valid-token", "AG_CREATE");
        verify(allocationGroupRepository, never()).save(any(AllocationGroup.class));
        verify(publisher, never()).publishEvent(any(AllocationGroupChanged.class));
    }
}
