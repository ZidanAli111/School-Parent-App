package com.ielts.cmds.lpr.domain;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.ielts.cmds.api.evt_228.AllocationGroupChanged;
import com.ielts.cmds.lpr.common.model.AllocationGroup;
import com.ielts.cmds.lpr.common.repository.AllocationGroupRepository;
import com.ielts.cmds.lpr.infrastructure.exception.CMDSLPRErrorResponse;
import com.ielts.cmds.lpr.infrastructure.exception.UnauthorizedException;
import com.ielts.cmds.lpr.infrastructure.mapper.AllocationGroupMapper;
import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;
import com.ielts.cmds.v2.rbac.api.service.RBACService;
import com.ielts.cmds.v2.rbac.api.service.exception.RbacValidationException;
import com.ielts.cmds.v2.serialization.application.utils.CMDSThreadLocalContextService;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.context.ApplicationEventPublisher;
import org.springframework.http.HttpHeaders;

import java.util.Set;

@ExtendWith(MockitoExtension.class)
class CreateAllocationGroupDomainServiceTest {

    @Mock
    private RBACService rbacService;

    @Mock
    private LPRCommonUtils lprCommonUtils;

    @Mock
    private AllocationGroupMapper allocationGroupMapper;

    @Mock
    private AllocationGroupRepository allocationGroupRepository;

    @Mock
    private ApplicationEventPublisher publisher;

    @Mock
    private ObjectMapper objectMapper;

    @Mock
    private CMDSThreadLocalContextService cmdsThreadLocalContextService;

    @InjectMocks
    private CreateAllocationGroupDomainService service;

    private HttpHeaders requestHeader;
    private AllocationGroupV1 requestBody;
    private AllocationGroupResponseV1 responseV1;
    private AllocationGroup allocationGroup;
    private AllocationGroupChanged allocationGroupChanged;

    @BeforeEach
    void setUp() {
        requestHeader = new HttpHeaders();
        requestHeader.add("x-access-token", "test-token");
        
        requestBody = new AllocationGroupV1();
        requestBody.setAllocationGroupName("Test Group");
        
        allocationGroup = new AllocationGroup();
        allocationGroup.setAllocationGroupName("Test Group");

        responseV1 = new AllocationGroupResponseV1();
        responseV1.setAllocationGroupName("Test Group");
        
        allocationGroupChanged = new AllocationGroupChanged();
    }

    @Test
    void testAddAllocationGroup_Success() throws RbacValidationException, UnauthorizedException {
        when(rbacService.isAuthorised(anyString(), anyString())).thenReturn(true);
        when(allocationGroupMapper.mapRequestToEntity(any())).thenReturn(allocationGroup);
        when(allocationGroupRepository.save(any())).thenReturn(allocationGroup);
        when(allocationGroupMapper.mapAllocationGroupToResponse(any())).thenReturn(responseV1);
        when(allocationGroupMapper.mapAllocationGroupChangeEvent(any())).thenReturn(allocationGroupChanged);

        AllocationGroupResponseV1 result = service.addAllocationGroup(requestBody, requestHeader);

        assertNotNull(result);
        assertEquals("Test Group", result.getAllocationGroupName());
        verify(publisher, times(1)).publishEvent(any(AllocationGroupChanged.class));
    }

    @Test
    void testAddAllocationGroup_Unauthorized() {
        when(rbacService.isAuthorised(anyString(), anyString())).thenReturn(false);
        when(lprCommonUtils.getSetforNullViolationofEventBody(anyString(), anyString())).thenReturn(Set.of());
        when(allocationGroupMapper.generateLPRErrorResponse(any(), anyString())).thenReturn(new CMDSLPRErrorResponse());

        UnauthorizedException exception = assertThrows(UnauthorizedException.class, 
            () -> service.addAllocationGroup(requestBody, requestHeader));

        assertNotNull(exception.getErrorResponse());
        verify(allocationGroupRepository, never()).save(any());
        verify(publisher, never()).publishEvent(any());
    }
}
