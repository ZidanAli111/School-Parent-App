  @PutMapping("/update/{allocationGroupUuid}")
    ResponseEntity<AllocationGroupResponseV1> updateAllocationGroup(@PathVariable UUID allocationGroupUuid,
                                                                    @RequestBody AllocationGroupV1 allocationGroupV1,
                                                                    @RequestHeader HttpHeaders httpHeaders) {
        log.debug("Inside update allocation group controller {}", httpHeaders);
 
        UUID transactionId = UUID.randomUUID();
        commonUtils.initializeHeaderContext(httpHeaders, transactionId);
 
        loggerUtil.initializeMDCContext(String.valueOf(transactionId), ALLOCATION_GROUP_UNIT, String.valueOf(ThreadLocalHeaderContext.getContext().getCorrelationId()));
 
        return ResponseEntity.status(HttpStatus.OK).body(updateAllocationGroupDomainService.editAllocationGroup(allocationGroupV1, allocationGroupUuid));
 
    }

