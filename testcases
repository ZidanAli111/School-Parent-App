package com.ielts.cmds.lpr.infrastructure.config;

import org.junit.jupiter.api.Test;
import org.springframework.security.config.annotation.web.builders.HttpSecurity;
import org.springframework.security.web.SecurityFilterChain;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.mock;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

class SecurityConfigTest {

    @Test
    void filterChain_ShouldConfigureSecurityProperly() throws Exception {
        // Arrange
        SecurityConfig securityConfig = new SecurityConfig();
        HttpSecurity http = mock(HttpSecurity.class);
        HttpSecurity.Customizer customizer = mock(HttpSecurity.Customizer.class);
        
        when(http.authorizeHttpRequests(any())).thenReturn(http);
        when(http.csrf(any())).thenReturn(http);
        when(http.cors(any())).thenReturn(http);
        
        // Act
        SecurityFilterChain filterChain = securityConfig.filterChain(http);
        
        // Assert
        assertNotNull(filterChain);
        verify(http).authorizeHttpRequests(auth -> auth.anyRequest().permitAll());
        verify(http).csrf(AbstractHttpConfigurer::disable);
        verify(http).cors(AbstractHttpConfigurer::disable);
    }
}
