package com.ielts.cmds.lpr.infrastructure.mapper;
 
import com.ielts.cmds.api.evt_228.AllocationGroupChanged;

import com.ielts.cmds.lpr.common.model.AllocationGroup;

import com.ielts.cmds.lpr.infrastructure.exception.CMDSLPRErrorResolver;

import com.ielts.cmds.ms.lpr_mx.AllocationGroupResponseV1;

import com.ielts.cmds.ms.lpr_mx.AllocationGroupV1;

import com.ielts.cmds.ms.lpr_mx.BaseEventErrorsErrorListInner;

import jakarta.validation.ConstraintViolation;

import lombok.RequiredArgsConstructor;

import lombok.extern.slf4j.Slf4j;

import org.springframework.stereotype.Service;
 
import java.util.List;

import java.util.Set;
 
@Slf4j

@Service

@RequiredArgsConstructor

public class AllocationGroupMapper {
 
    private final CMDSLPRErrorResolver<Object> lprErrorResolver;
 
    public AllocationGroupResponseV1 mapAllocationGroupV1ToAllocationGroup(AllocationGroup allocationGroup) {
 
        AllocationGroupResponseV1 allocationGroupResponseV1 = new AllocationGroupResponseV1();

        allocationGroupResponseV1.setAllocationGroupUuid(allocationGroup.getAllocationGroupUuid());

        allocationGroupResponseV1.setAllocationGroupName(allocationGroup.getAllocationGroupName());

        allocationGroupResponseV1.setAllocationGroupId(allocationGroup.getAllocationGroupId());

        allocationGroupResponseV1.setEffectiveFromDate(allocationGroup.getEffectiveFromDate());

        allocationGroupResponseV1.setEffectiveToDate(allocationGroup.getEffectiveToDate());
 
        return allocationGroupResponseV1;

    }
 
    public AllocationGroup mapRequestToEntity(AllocationGroupV1 allocationGroupReqBody) {
 
        return AllocationGroup.builder()

                .allocationGroupName(allocationGroupReqBody.getAllocationGroupName())

                .effectiveFromDate(allocationGroupReqBody.getEffectiveFromDate())

                .effectiveToDate((allocationGroupReqBody.getEffectiveToDate()))

                .build();
 
    }
 
    public AllocationGroup mapUpdateRequestToEntity(AllocationGroupV1 allocationGroupReqBody, AllocationGroup existingAllocationGroup) {
 
        return AllocationGroup.builder()

                .allocationGroupName(allocationGroupReqBody.getAllocationGroupName())

                .effectiveFromDate(allocationGroupReqBody.getEffectiveFromDate())

                .effectiveToDate((allocationGroupReqBody.getEffectiveToDate()))

                .build();
 
 
    }
 
 
    public AllocationGroupChanged mapAllocationGroupChangeEvent(AllocationGroupResponseV1 allocationGroupResponse) {
 
        AllocationGroupChanged allocationGroupChanged = new AllocationGroupChanged();

        allocationGroupChanged.setAllocationGroupUuid(allocationGroupResponse.getAllocationGroupUuid());

        allocationGroupChanged.setAllocationGroupId(allocationGroupResponse.getAllocationGroupId());

        allocationGroupChanged.setAllocationGroupName(allocationGroupResponse.getAllocationGroupName());

        allocationGroupChanged.setEffectiveFromDate(allocationGroupResponse.getEffectiveFromDate());

        allocationGroupChanged.setEffectiveToDate(allocationGroupResponse.getEffectiveToDate());
 
        return allocationGroupChanged;

    }
 
    /**

     * Generates an error response for constraint violations.

     *

     * @param constraintViolations the constraint violations

     * @return the error response

     */

    public List<BaseEventErrorsErrorListInner> generateLPRErrorResponse(Set<ConstraintViolation<Object>> constraintViolations, String permission) {

        return lprErrorResolver.populateErrorResponse(constraintViolations, permission);

    }
 
}

 
