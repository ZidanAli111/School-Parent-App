import static com.ielts.cmds.lpr.infrastructure.utils.AllocationGroupConstants.X_ACCESS_TOKEN;

import static org.junit.jupiter.api.Assertions.assertEquals;

import static org.junit.jupiter.api.Assertions.assertNotNull;

import static org.junit.jupiter.api.Assertions.assertThrows;

import static org.mockito.Mockito.anyString;

import static org.mockito.Mockito.eq;

import static org.mockito.Mockito.times;

import static org.mockito.Mockito.verify;

import static org.mockito.Mockito.when;
 
@ExtendWith(MockitoExtension.class)

class AllocationGroupControllerTest {
 
    @Mock

    private CreateAllocationGroupDomainService createAllocationGroupDomainService;
 
    @Mock

    private CMDSLoggerUtils loggerUtil;
 
    @Mock

    private LPRCommonUtils commonUtils;
 
    @InjectMocks

    private AllocationGroupController allocationGroupController;
 
    private AllocationGroupV1 allocationGroupV1;
 
    private AllocationGroupResponseV1 allocationGroupResponseV1;
 
    private HttpHeaders httpHeaders;
 
    @BeforeEach

    void setUp() {
 
        allocationGroupV1 = new AllocationGroupV1();

        allocationGroupV1.setAllocationGroupName("Test Group");

        allocationGroupV1.setEffectiveFromDate(LocalDate.parse("2025-03-20"));

        allocationGroupV1.setEffectiveToDate(LocalDate.parse("2025-06-14"));
 
        allocationGroupResponseV1 = new AllocationGroupResponseV1();
 
        allocationGroupResponseV1.setAllocationGroupUuid(UUID.fromString("b2885ba0-cb85-4629-a0af-1db25f3d7154"));

        allocationGroupResponseV1.setAllocationGroupId(1);

        allocationGroupResponseV1.setAllocationGroupName("Test Group");

        allocationGroupResponseV1.setEffectiveFromDate(LocalDate.parse("2025-03-20"));

        allocationGroupResponseV1.setEffectiveToDate(LocalDate.parse("2025-06-14"));
 
        httpHeaders = new HttpHeaders();

        httpHeaders.add(X_ACCESS_TOKEN, "valid-token");

        httpHeaders.add(AllocationGroupConstants.CORRELATION_ID, UUID.randomUUID().toString());
 
    }
 
    @Test

    void testCreateAllocationGroup_Success() throws RbacValidationException {
 
        when(createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, httpHeaders))

                .thenReturn(allocationGroupResponseV1);

        when(commonUtils.getPartnerCode("valid-token")).thenReturn("partner-code");
 
        ResponseEntity<AllocationGroupResponseV1> response = allocationGroupController.createAllocationGroup(allocationGroupV1, httpHeaders);
 
        assertNotNull(response);

        assertEquals(HttpStatus.OK, response.getStatusCode());

        assertEquals(allocationGroupResponseV1, response.getBody());

        CMDSHeaderContext headerContext = ThreadLocalHeaderContext.getContext();
 
        assertEquals(UUID.fromString(httpHeaders.getFirst(AllocationGroupConstants.CORRELATION_ID)), headerContext.getCorrelationId());
 
        verify(createAllocationGroupDomainService, times(1)).addAllocationGroup(allocationGroupV1, httpHeaders);
 
        assertNotNull(headerContext);

        assertEquals(UUID.fromString(httpHeaders.getFirst(AllocationGroupConstants.CORRELATION_ID)), headerContext.getCorrelationId());
 
        CMDSAuditContext auditContext = ThreadLocalAuditContext.getContext();
 
        assertNotNull(auditContext);

        assertEquals(headerContext.getCorrelationId(), auditContext.getCausedByCorrelationId());

        assertEquals(headerContext.getEventDateTime(), auditContext.getCausedByEventDateTime());

        assertEquals(headerContext.getTransactionId(), auditContext.getCausedByTransactionId());
 
    }
 
    @Test

    void testCreateAllocationGroup_ThrowsException() throws RbacValidationException {
 
        when(createAllocationGroupDomainService.addAllocationGroup(allocationGroupV1, httpHeaders))

                .thenThrow(new RbacValidationException("RBAC Error", new RuntimeException("RBAC validation error occurred")));
 
        assertThrows(RbacValidationException.class, () ->

                allocationGroupController.createAllocationGroup(allocationGroupV1, httpHeaders));
 
        verify(loggerUtil, times(1)).initializeMDCContext(anyString(), eq("Allocation Group Unit"), anyString());

        verify(createAllocationGroupDomainService, times(1))

                .addAllocationGroup(allocationGroupV1, httpHeaders);
 
    }
 
    @Test

    void testInitializeHeaderContext() throws RbacValidationException {

        HttpHeaders requestHeader = new HttpHeaders();
 
        requestHeader.add(X_ACCESS_TOKEN, "valid-token");

        requestHeader.add(AllocationGroupConstants.CORRELATION_ID, UUID.randomUUID().toString());
 
        when(commonUtils.getPartnerCode("valid-token")).thenReturn("partner-code");

        commonUtils.initializeHeaderContext(requestHeader);
 
        CMDSHeaderContext headerContext = ThreadLocalHeaderContext.getContext();
 
        assertNotNull(headerContext);
 
        assertEquals(UUID.fromString(requestHeader.getFirst(AllocationGroupConstants.CORRELATION_ID)), headerContext.getCorrelationId());
 
        assertNotNull(headerContext.getEventDateTime());

        assertNotNull(headerContext.getTransactionId());

        assertNotNull(headerContext.getEventContext());
 
        CMDSAuditContext auditContext = ThreadLocalAuditContext.getContext();
 
        assertNotNull(auditContext);

        assertEquals(headerContext.getCorrelationId(), auditContext.getCausedByCorrelationId());

        assertEquals(headerContext.getEventDateTime(), auditContext.getCausedByEventDateTime());

        assertEquals(headerContext.getTransactionId(), auditContext.getCausedByTransactionId());
 
        verify(commonUtils, times(1)).getPartnerCode("valid-token");
 
    }
 
}

 
