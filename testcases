package com.ielts.cmds.lpr.domain;

import com.ielts.cmds.lpr.common.model.AllocationGroup;
import com.ielts.cmds.lpr.common.repository.AllocationGroupRepository;
import com.ielts.cmds.lpr.infrastructure.exception.AllocationGroupNotFoundException;
import com.ielts.cmds.lpr.infrastructure.exception.UnauthorizedException;
import com.ielts.cmds.lpr.infrastructure.mapper.AllocationGroupMapper;
import com.ielts.cmds.lpr.infrastructure.utils.AllocationGroupConstants;
import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;
import com.ielts.cmds.ms.lpr_mx.AllocationGroupResponseV1;
import com.ielts.cmds.ms.lpr_mx.BaseEventErrorsErrorListInner;
import com.ielts.cmds.v2.infrastructure.event.context.ThreadLocalHeaderContext;
import com.ielts.cmds.v2.rbac.api.service.RBACService;
import jakarta.validation.ConstraintViolation;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import java.util.List;
import java.util.Optional;
import java.util.Set;
import java.util.UUID;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.ArgumentMatchers.any;
import static org.mockito.ArgumentMatchers.anyString;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class ViewSingleAllocationGroupDomainServiceTest {

    @Mock
    private RBACService rbacService;

    @Mock
    private LPRCommonUtils lprCommonUtils;

    @Mock
    private AllocationGroupMapper allocationGroupMapper;

    @Mock
    private AllocationGroupRepository allocationGroupRepository;

    @InjectMocks
    private ViewSingleAllocationGroupDomainService viewSingleAllocationGroupDomainService;

    private final UUID TEST_UUID = UUID.fromString("ba8584f7-8688-47c6-91d5-7ebb41d01d7f");

    @Test
    void viewAllocationGroup_WhenAuthorizedAndExists_ShouldReturnResponse() {
        // Arrange
        AllocationGroup mockEntity = new AllocationGroup();
        AllocationGroupResponseV1 mockResponse = new AllocationGroupResponseV1();
        
        when(rbacService.isAuthorised(anyString(), anyString())).thenReturn(true);
        when(allocationGroupRepository.findById(TEST_UUID)).thenReturn(Optional.of(mockEntity));
        when(allocationGroupMapper.mapAllocationGroupV1ToAllocationGroup(mockEntity))
            .thenReturn(mockResponse);

        // Act
        AllocationGroupResponseV1 result = viewSingleAllocationGroupDomainService.viewAllocationGroup(TEST_UUID);

        // Assert
        assertNotNull(result);
        assertEquals(mockResponse, result);
        verify(rbacService, times(1)).isAuthorised(anyString(), eq(AllocationGroupConstants.AG_VIEW));
        verify(allocationGroupRepository, times(1)).findById(TEST_UUID);
    }

    @Test
    void viewAllocationGroup_WhenUnauthorized_ShouldThrowException() {
        // Arrange
        Set<ConstraintViolation<Object>> mockViolations = mock(Set.class);
        List<BaseEventErrorsErrorListInner> mockErrors = mock(List.class);
        
        when(rbacService.isAuthorised(anyString(), anyString())).thenReturn(false);
        when(lprCommonUtils.getSetForNullViolationOfEventBody(anyString(), anyString()))
            .thenReturn(mockViolations);
        when(allocationGroupMapper.generateLPRErrorResponse(mockViolations, AllocationGroupConstants.AG_VIEW))
            .thenReturn(mockErrors);

        // Act & Assert
        UnauthorizedException exception = assertThrows(UnauthorizedException.class, 
            () -> viewSingleAllocationGroupDomainService.viewAllocationGroup(TEST_UUID));
        
        assertEquals(VIEW_ALLOCATION_GROUP_PERMISSION_FAILURE, exception.getMessage());
        verify(rbacService, times(1)).isAuthorised(anyString(), eq(AllocationGroupConstants.AG_VIEW));
    }

    @Test
    void viewAllocationGroup_WhenNotFound_ShouldThrowException() {
        // Arrange
        when(rbacService.isAuthorised(anyString(), anyString())).thenReturn(true);
        when(allocationGroupRepository.findById(TEST_UUID)).thenReturn(Optional.empty());

        // Act & Assert
        AllocationGroupNotFoundException exception = assertThrows(AllocationGroupNotFoundException.class, 
            () -> viewSingleAllocationGroupDomainService.viewAllocationGroup(TEST_UUID));
        
        assertTrue(exception.getMessage().contains("AllocationGroup with UUId"));
        verify(allocationGroupRepository, times(1)).findById(TEST_UUID);
    }

    @Test
    void viewAllocationGroup_WhenNullUuid_ShouldThrowException() {
        // Act & Assert
        assertThrows(IllegalArgumentException.class, 
            () -> viewSingleAllocationGroupDomainService.viewAllocationGroup(null));
    }
}
