package com.ielts.cmds.lpr.infrastructure.utils;

import com.ielts.cmds.v2.infrastructure.event.context.CMDSAuditContext;
import com.ielts.cmds.v2.infrastructure.event.context.CMDSHeaderContext;
import com.ielts.cmds.v2.infrastructure.event.context.ThreadLocalAuditContext;
import com.ielts.cmds.v2.infrastructure.event.context.ThreadLocalHeaderContext;
import com.ielts.cmds.v2.rbac.api.service.RBACService;
import com.ielts.cmds.v2.rbac.api.service.model.CmdsAuthentication;
import com.ielts.cmds.v2.rbac.api.service.model.UserDetails;
import jakarta.validation.ConstraintViolation;
import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.HttpHeaders;

import java.time.LocalDateTime;
import java.util.HashMap;
import java.util.Set;
import java.util.UUID;

import static com.ielts.cmds.lpr.infrastructure.utils.AllocationGroupConstants.*;
import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class LPRCommonUtilsTest {

    @Mock
    private RBACService rbacService;

    @InjectMocks
    private LPRCommonUtils lprCommonUtils;

    private HttpHeaders headers;
    private UUID transactionId;
    private final String testPartnerCode = "TEST_PARTNER";
    private final String testAccessToken = "test-token";
    private final String testCorrelationId = "a1b2c3d4-e5f6-7890-g1h2-i3j4k5l6m7n8";
    private final String testEventDateTime = "2023-01-01T12:00:00";

    @BeforeEach
    void setUp() {
        headers = new HttpHeaders();
        headers.add(X_ACCESS_TOKEN, testAccessToken);
        headers.add(CORRELATION_ID, testCorrelationId);
        headers.add(EVENT_DATE_TIME, testEventDateTime);
        
        transactionId = UUID.randomUUID();
        
        // Clear any existing context
        ThreadLocalHeaderContext.clearContext();
        ThreadLocalAuditContext.clearContext();
    }

    @AfterEach
    void tearDown() {
        ThreadLocalHeaderContext.clearContext();
        ThreadLocalAuditContext.clearContext();
    }

    @Test
    void getSetForNullViolationOfEventBody_ShouldCreateConstraintViolation() {
        String errorMessage = "Field cannot be null";
        String pathProperty = "fieldName";
        
        Set<ConstraintViolation<Object>> violations = 
            lprCommonUtils.getSetForNullViolationOfEventBody(errorMessage, pathProperty);
        
        assertEquals(1, violations.size());
        ConstraintViolation<Object> violation = violations.iterator().next();
        assertEquals(errorMessage, violation.getMessage());
        assertEquals(pathProperty, violation.getPropertyPath().toString());
        assertNull(violation.getInvalidValue());
    }

    @Test
    void buildHeader_ShouldCreateAndSetHeaderContext() {
        String eventName = "TEST_EVENT";
        
        // Setup existing context
        CMDSHeaderContext existingContext = new CMDSHeaderContext();
        existingContext.setCorrelationId(UUID.randomUUID());
        existingContext.setTransactionId(UUID.randomUUID());
        existingContext.setPartnerCode("EXISTING_PARTNER");
        ThreadLocalHeaderContext.setContext(existingContext);
        
        CMDSHeaderContext result = lprCommonUtils.buildHeader(eventName);
        
        assertNotNull(result);
        assertEquals(existingContext.getCorrelationId(), result.getCorrelationId());
        assertEquals(existingContext.getTransactionId(), result.getTransactionId());
        assertEquals(existingContext.getPartnerCode(), result.getPartnerCode());
        assertEquals(eventName, result.getEventName());
        assertNotNull(result.getEventDateTime());
        
        // Verify context was set
        assertEquals(result, ThreadLocalHeaderContext.getContext());
    }

    @Test
    void getPartnerCode_ShouldReturnPartnerCodeFromToken() {
        CmdsAuthentication authentication = mock(CmdsAuthentication.class);
        UserDetails userDetails = mock(UserDetails.class);
        
        when(rbacService.getCmdsAuthentication(testAccessToken)).thenReturn(authentication);
        when(authentication.getUserDetails()).thenReturn(userDetails);
        when(userDetails.getPartnerCode()).thenReturn(testPartnerCode);
        
        String result = lprCommonUtils.getPartnerCode(testAccessToken);
        
        assertEquals(testPartnerCode, result);
        verify(rbacService).getCmdsAuthentication(testAccessToken);
    }

    @Test
    void initializeHeaderContext_ShouldSetHeaderAndAuditContexts() {
        // Mock RBAC service
        CmdsAuthentication authentication = mock(CmdsAuthentication.class);
        UserDetails userDetails = mock(UserDetails.class);
        
        when(rbacService.getCmdsAuthentication(testAccessToken)).thenReturn(authentication);
        when(authentication.getUserDetails()).thenReturn(userDetails);
        when(userDetails.getPartnerCode()).thenReturn(testPartnerCode);
        
        lprCommonUtils.initializeHeaderContext(headers, transactionId);
        
        // Verify header context
        CMDSHeaderContext headerContext = ThreadLocalHeaderContext.getContext();
        assertNotNull(headerContext);
        assertEquals(UUID.fromString(testCorrelationId), headerContext.getCorrelationId());
        assertEquals(LocalDateTime.parse(testEventDateTime), headerContext.getEventDateTime());
        assertEquals(transactionId, headerContext.getTransactionId());
        assertEquals(testPartnerCode, headerContext.getPartnerCode());
        assertNotNull(headerContext.getEventContext());
        
        // Verify audit context
        CMDSAuditContext auditContext = ThreadLocalAuditContext.getContext();
        assertNotNull(auditContext);
        assertEquals(headerContext.getCorrelationId(), auditContext.getCausedByCorrelationId());
        assertEquals(headerContext.getEventDateTime(), auditContext.getCausedByEventDateTime());
        assertEquals(headerContext.getTransactionId(), auditContext.getCausedByTransactionId());
    }

    @Test
    void initializeHeaderContext_ShouldThrowException_WhenMissingRequiredHeaders() {
        HttpHeaders incompleteHeaders = new HttpHeaders();
        incompleteHeaders.add(X_ACCESS_TOKEN, testAccessToken);
        
        assertThrows(NullPointerException.class, 
            () -> lprCommonUtils.initializeHeaderContext(incompleteHeaders, transactionId));
    }

    @Test
    void initializeHeaderContext_ShouldThrowException_WhenRBACFails() {
        when(rbacService.getCmdsAuthentication(testAccessToken)).thenThrow(new RuntimeException("RBAC Error"));
        
        assertThrows(RuntimeException.class, 
            () -> lprCommonUtils.initializeHeaderContext(headers, transactionId));
    }
}
