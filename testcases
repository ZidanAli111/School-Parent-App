package com.ielts.cmds.lpr.controller;

import com.ielts.cmds.lpr.domain.CreateAllocationGroupDomainService;
import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;
import com.ielts.cmds.v2.common.logger.util.CMDSLoggerUtils;
import com.ielts.cmds.v2.rbac.api.service.exception.RbacValidationException;
import lpr_mx.AllocationGroupResponseV1;
import lpr_mx.AllocationGroupV1;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.Mockito;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;

import java.util.UUID;

import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

@ExtendWith(MockitoExtension.class)
class AllocationGroupControllerTest {

    @Mock
    private CreateAllocationGroupDomainService createAllocationGroupDomainService;

    @Mock
    private CMDSLoggerUtils loggerUtil;

    @Mock
    private LPRCommonUtils commonUtils;

    @InjectMocks
    private AllocationGroupController allocationGroupController;

    private AllocationGroupV1 allocationGroup;
    private HttpHeaders httpHeaders;
    private AllocationGroupResponseV1 allocationGroupResponse;

    @BeforeEach
    void setUp() {
        // Sample test data
        allocationGroup = new AllocationGroupV1();
        httpHeaders = new HttpHeaders();
        httpHeaders.add("x-access-token", "test-access-token");
        httpHeaders.add("correlationid", UUID.randomUUID().toString());

        allocationGroupResponse = new AllocationGroupResponseV1();
    }

    @Test
    void createAllocationGroup_ShouldReturnOkResponse() throws RbacValidationException {
        // Mock behavior
        when(createAllocationGroupDomainService.addAllocationGroup(any(), any())).thenReturn(allocationGroupResponse);

        // Call method
        ResponseEntity<AllocationGroupResponseV1> response = allocationGroupController.createAllocationGroup(allocationGroup, httpHeaders);

        // Assertions
        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(allocationGroupResponse, response.getBody());

        // Verify that the service method was called
        verify(createAllocationGroupDomainService, times(1)).addAllocationGroup(any(), any());
    }

    @Test
    void createAllocationGroup_ShouldThrowException_WhenValidationFails() throws RbacValidationException {
        // Mock behavior to throw an exception
        when(createAllocationGroupDomainService.addAllocationGroup(any(), any()))
                .thenThrow(new RbacValidationException("Validation Error"));

        // Assertion for exception
        RbacValidationException thrown = assertThrows(RbacValidationException.class, () -> {
            allocationGroupController.createAllocationGroup(allocationGroup, httpHeaders);
        });

        assertEquals("Validation Error", thrown.getMessage());

        // Verify that the service method was called
        verify(createAllocationGroupDomainService, times(1)).addAllocationGroup(any(), any());
    }
}
