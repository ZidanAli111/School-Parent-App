package com.ielts.cmds.lpr.controller;
 
import com.ielts.cmds.lpr.domain.CreateAllocationGroupDomainService;

import com.ielts.cmds.lpr.infrastructure.utils.AllocationGroupConstants;

import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;

import com.ielts.cmds.v2.common.logger.util.CMDSLoggerUtils;

import com.ielts.cmds.v2.infrastructure.event.context.CMDSAuditContext;

import com.ielts.cmds.v2.infrastructure.event.context.CMDSHeaderContext;

import com.ielts.cmds.v2.infrastructure.event.context.ThreadLocalAuditContext;

import com.ielts.cmds.v2.infrastructure.event.context.ThreadLocalHeaderContext;

import com.ielts.cmds.v2.rbac.api.service.exception.RbacValidationException;

import lombok.RequiredArgsConstructor;

import lombok.extern.slf4j.Slf4j;

import lpr_mx.AllocationGroupResponseV1;

import lpr_mx.AllocationGroupV1;

import org.springframework.beans.factory.annotation.Autowired;

import org.springframework.http.HttpHeaders;

import org.springframework.http.HttpStatus;

import org.springframework.http.ResponseEntity;

import org.springframework.web.bind.annotation.CrossOrigin;

import org.springframework.web.bind.annotation.PostMapping;

import org.springframework.web.bind.annotation.RequestBody;

import org.springframework.web.bind.annotation.RequestHeader;

import org.springframework.web.bind.annotation.RequestMapping;

import org.springframework.web.bind.annotation.RestController;
 
import java.time.LocalDateTime;

import java.util.HashMap;

import java.util.Objects;

import java.util.UUID;
 
@CrossOrigin(origins = "${ui.allowedOrigin}")

@Slf4j

@RestController

@RequestMapping("/v1/allocationgroup")

@RequiredArgsConstructor

public class AllocationGroupController {
 
    private final CreateAllocationGroupDomainService createAllocationGroupDomainService;

    private final CMDSLoggerUtils loggerUtil;

    @Autowired

    private LPRCommonUtils commonUtils;
 
    @PostMapping(value = "/add")

    ResponseEntity<AllocationGroupResponseV1> createAllocationGroup(

            @RequestBody AllocationGroupV1 allocationGroup,

            @RequestHeader HttpHeaders httpHeaders) throws RbacValidationException {

        loggerUtil.initializeMDCContext(UUID.randomUUID().toString(), "Allocation Group Unit",

                httpHeaders.containsKey(AllocationGroupConstants.CORRELATION_ID) ?

                        Objects.requireNonNull(httpHeaders.get(AllocationGroupConstants.CORRELATION_ID)).getFirst() : UUID.randomUUID().toString()

        );

        initializeHeaderContext(httpHeaders);

        log.info("Inside create allocation group controller");

        return ResponseEntity.status(HttpStatus.OK).body(createAllocationGroupDomainService.addAllocationGroup(allocationGroup, httpHeaders));

    }
 
    public void initializeHeaderContext(HttpHeaders requestHeader) throws RbacValidationException {

        String accessToken = Objects.requireNonNull(requestHeader.get("x-access-token")).getFirst();

        String correlationId = Objects.requireNonNull(requestHeader.get("correlationid")).getFirst();

        String connectionId = (Objects.nonNull(requestHeader.get("connectionid"))) ?

                Objects.requireNonNull(requestHeader.get("connectionid")).getFirst() : null;

        String partnerCode = commonUtils.getPartnerCode(accessToken);

        CMDSHeaderContext cmdsHeaderContext = new CMDSHeaderContext();

        cmdsHeaderContext.setCorrelationId(UUID.fromString(correlationId));

        cmdsHeaderContext.setEventDateTime(LocalDateTime.now());

        cmdsHeaderContext.setTransactionId(UUID.randomUUID());

        cmdsHeaderContext.setEventContext(new HashMap<>());

        cmdsHeaderContext.setXaccessToken(accessToken);

        cmdsHeaderContext.setConnectionId(connectionId);

        cmdsHeaderContext.setPartnerCode(partnerCode);

        ThreadLocalHeaderContext.setContext(cmdsHeaderContext);
 
        CMDSAuditContext cmdsAuditContext = new CMDSAuditContext();
 
        cmdsAuditContext.setCausedByCorrelationId(ThreadLocalHeaderContext.getContext().getCorrelationId());

        cmdsAuditContext.setCausedByEventDateTime(ThreadLocalHeaderContext.getContext().getEventDateTime());

        cmdsAuditContext.setCausedByTransactionId(ThreadLocalHeaderContext.getContext().getTransactionId());

        ThreadLocalAuditContext.setContext(cmdsAuditContext);

    }

}
 
 
