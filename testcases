import java.util.Map;

import java.util.Set;

import java.util.UUID;
 
import static org.junit.jupiter.api.Assertions.assertEquals;

import static org.junit.jupiter.api.Assertions.assertNotNull;

import static org.mockito.Mockito.mock;

import static org.mockito.Mockito.mockStatic;

import static org.mockito.Mockito.when;
 
@ExtendWith(MockitoExtension.class)

class LPRCommonUtilsTest {
 
    @InjectMocks

    private LPRCommonUtils lprCommonUtils;
 
    @Mock

    private RBACService rbacService;
 
    @Mock

    private CmdsAuthentication cmdsAuthentication;
 
    @Mock

    private UserDetails userDetails;
 
 
    @SneakyThrows

    @Test

    void testGetPartnerCode()  {
 
        String xAccessToken = "valid-token";

        String expectedPartnerCode = "testPartnerCode";
 
        when(rbacService.getCmdsAuthentication(xAccessToken)).thenReturn(cmdsAuthentication);

        when(cmdsAuthentication.getUserDetails()).thenReturn(userDetails);

        when(userDetails.getPartnerCode()).thenReturn(expectedPartnerCode);
 
        String actualPartnerCode = lprCommonUtils.getPartnerCode(xAccessToken);

        assertEquals(expectedPartnerCode, actualPartnerCode);
 
    }
 
    @Test

    void testGetSetForNullViolationOfEventBody() {

        String expectedMessage = "Test message";

        String expectedPath = "testField";

        Set<ConstraintViolation<Object>> violations = lprCommonUtils.getSetForNullViolationOfEventBody(expectedMessage, expectedPath);
 
        assertNotNull(violations);

        assertEquals(1, violations.size());

        ConstraintViolation<Object> violation = violations.iterator().next();

        assertEquals(expectedMessage, violation.getMessage());

        assertEquals(expectedPath, violation.getPropertyPath().toString());

    }
 
    @Test

    void testBuildHeader() {
 
        String eventName = "TestEvent";

        Map<String, String> eventContextValue = new HashMap<String, String>();

        eventContextValue.put("key_1", "test-context1");

        eventContextValue.put("key_2", "test-context2");

        CMDSHeaderContext mockContext = new CMDSHeaderContext();

        mockContext.setCorrelationId(UUID.fromString("fbcb51b7-d88e-470e-b879-2eb3ecc43276"));

        mockContext.setTransactionId(UUID.fromString("184f4c69-cbf1-4eab-b8e5-768c30bb9c02"));

        mockContext.setEventContext(eventContextValue);

        mockContext.setXaccessToken("test-token");

        mockContext.setConnectionId("test-connection-id");

        mockContext.setPartnerCode("test-partner");
 
        try (MockedStatic<ThreadLocalHeaderContext> mockedContext = mockStatic(ThreadLocalHeaderContext.class)) {

            mockedContext.when(ThreadLocalHeaderContext::getContext).thenReturn(mockContext);

            CMDSHeaderContext result = lprCommonUtils.buildHeader(eventName);
 
            assertNotNull(result);

            assertEquals(UUID.fromString("fbcb51b7-d88e-470e-b879-2eb3ecc43276"), result.getCorrelationId());

            assertEquals(UUID.fromString("184f4c69-cbf1-4eab-b8e5-768c30bb9c02"), result.getTransactionId());

            assertEquals("test-partner", result.getPartnerCode());

            assertEquals(eventName, result.getEventName());

            assertNotNull(result.getEventDateTime());
 
            assertNotNull(result.getEventContext());

            assertEquals("test-context1", result.getEventContext().get("key_1"));

            assertEquals("test-context2", result.getEventContext().get("key_2"));
 
        }

    }
 
}
 
