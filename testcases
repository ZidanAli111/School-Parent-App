import org.junit.jupiter.api.Test;
import org.mockito.ArgumentCaptor;
import org.mockito.Captor;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.MockitoAnnotations;
import org.slf4j.Logger;

import java.util.HashSet;
import java.util.Set;
import javax.validation.ConstraintViolation;

import static org.mockito.Mockito.*;
import static org.junit.jupiter.api.Assertions.*;

public class AllocationGroupMapperTest {

    @Mock
    private LprErrorResolver lprErrorResolver;

    @Mock
    private Logger mockLogger; // Mock the Logger

    @InjectMocks
    private AllocationGroupMapper allocationGroupMapper; // Inject mocks into the class

    @Captor
    private ArgumentCaptor<String> logMessageCaptor; // Capture log messages

    public AllocationGroupMapperTest() {
        MockitoAnnotations.openMocks(this); // Initialize mocks
    }

    @Test
    public void testGenerateLPRErrorResponse() {
        // Arrange
        ConstraintViolation<Object> violation1 = mock(ConstraintViolation.class);
        ConstraintViolation<Object> violation2 = mock(ConstraintViolation.class);

        when(violation1.getMessage()).thenReturn("Field A is invalid");
        when(violation2.getMessage()).thenReturn("Field B must not be null");

        Set<ConstraintViolation<Object>> violations = new HashSet<>();
        violations.add(violation1);
        violations.add(violation2);

        CMDSLPRErrorResponse errorResponse = new CMDSLPRErrorResponse();
        when(lprErrorResolver.populateErrorResponse(eq(violations), eq("permission"))).thenReturn(errorResponse);

        // Inject the mock logger into the mapper (if it's a field inside AllocationGroupMapper)
        ReflectionTestUtils.setField(allocationGroupMapper, "log", mockLogger);

        // Act
        CMDSLPRErrorResponse response = allocationGroupMapper.generateLPRErrorResponse(violations, "permission");

        // Assert
        assertNotNull(response);
        assertEquals(errorResponse, response);
        verify(lprErrorResolver, times(1)).populateErrorResponse(eq(violations), eq("permission"));

        // Capture log messages
        verify(mockLogger, atLeastOnce()).debug(logMessageCaptor.capture());

        // Extract captured log messages
        assertTrue(logMessageCaptor.getAllValues().contains("Constraint violation message in generateLPRErrorResponse: Field A is invalid"));
        assertTrue(logMessageCaptor.getAllValues().contains("Constraint violation message in generateLPRErrorResponse: Field B must not be null"));
    }
}
