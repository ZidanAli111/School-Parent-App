@ExtendWith(MockitoExtension.class)

class ViewSingleAllocationGroupDomainServiceTest {
 
    @Mock

    private RBACService rbacService;
 
    @Mock

    private LPRCommonUtils lprCommonUtils;
 
    @Mock

    private AllocationGroupMapper allocationGroupMapper;
 
    @Mock

    private AllocationGroupRepository allocationGroupRepository;
 
    @InjectMocks

    private ViewSingleAllocationGroupDomainService viewSingleAllocationGroupDomainService;
 
    private AllocationGroup allocationGroup;

    private AllocationGroupResponseV1 allocationGroupResponseV1;
 
    @BeforeEach

    void setUp() {

        CMDSHeaderContext eventHeader = getCmdsHeaderContext();

        ThreadLocalHeaderContext.setContext(eventHeader);

        CMDSAuditContext auditContext = getCmdsAuditContext();

        ThreadLocalAuditContext.setContext(auditContext);

        ReflectionTestUtils.setField(viewSingleAllocationGroupDomainService, "rbacService", rbacService);

        ReflectionTestUtils.setField(viewSingleAllocationGroupDomainService, "lprCommonUtils", lprCommonUtils);

        ReflectionTestUtils.setField(viewSingleAllocationGroupDomainService, "allocationGroupMapper", allocationGroupMapper);

        ReflectionTestUtils.setField(viewSingleAllocationGroupDomainService, "allocationGroupRepository", allocationGroupRepository);

        allocationGroup=setAllocationGroup();

        allocationGroupResponseV1=setAllocationGroupResponseV1();

    }
 
    @SneakyThrows

    @Test

    void givenAuthorizedUser_whenViewAllocationGroup_thenReturnAllocationGroup()  {
 
        when(rbacService.isAuthorised(anyString(), eq(AllocationGroupConstants.AG_VIEW))).thenReturn(true);

        when(allocationGroupRepository.findById(allocationGroup.getAllocationGroupUuid())).thenReturn(Optional.ofNullable(allocationGroup));
 
 
        AllocationGroupResponseV1 result = viewSingleAllocationGroupDomainService

                .viewAllocationGroup(allocationGroup.getAllocationGroupUuid());
 
 
        assertEquals( allocationGroupResponseV1,result);

        verify(rbacService, times(1)).isAuthorised(anyString(), eq(AllocationGroupConstants.AG_VIEW));

        verify(allocationGroupRepository, times(1)).findById(allocationGroup.getAllocationGroupUuid());

    }
 
 
    @SneakyThrows

    @Test

    void givenUnauthorizedUser_whenViewAllocationGroup_thenThrowUnauthorizedException()  {
 
        HttpHeaders headers = setHttpHeaders();

        headers.add(AUTHORIZATION, "invalid-token");

        when(rbacService.isAuthorised(anyString(), eq(AllocationGroupConstants.AG_VIEW))).thenReturn(false);

        Set<ConstraintViolation<Object>> violations = Collections.emptySet();

        when(lprCommonUtils.getSetForNullViolationOfEventBody(anyString(), anyString())).thenReturn(violations);

        List<BaseEventErrorsErrorListInner> errorResponse = new ArrayList<>();

        when(allocationGroupMapper.generateLPRErrorResponse(violations, AllocationGroupConstants.AG_VIEW)).thenReturn(errorResponse);
 
 
        UnauthorizedException exception = assertThrows(UnauthorizedException.class, () -> {

            viewSingleAllocationGroupDomainService.viewAllocationGroup(allocationGroup.getAllocationGroupUuid());

        });
 
        assertEquals(VIEW_ALLOCATION_GROUP_PERMISSION_FAILURE, exception.getMessage());

        verify(rbacService, times(1)).isAuthorised(anyString(), eq(AllocationGroupConstants.AG_VIEW));

    }

}
 
