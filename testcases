import static org.junit.jupiter.api.Assertions.*;
import static org.mockito.Mockito.*;

import java.util.UUID;

import org.junit.jupiter.api.AfterEach;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.ArgumentCaptor;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;
import org.springframework.http.HttpHeaders;
import org.springframework.http.HttpStatus;
import org.springframework.http.ResponseEntity;

import com.ielts.cmds.lpr.domain.CreateAllocationGroupDomainService;
import com.ielts.cmds.lpr.infrastructure.utils.LPRCommonUtils;
import com.ielts.cmds.v2.common.logger.util.CMDSLoggerUtils;
import com.ielts.cmds.v2.infrastructure.event.context.ThreadLocalAuditContext;
import com.ielts.cmds.v2.infrastructure.event.context.ThreadLocalHeaderContext;
import com.ielts.cmds.v2.rbac.api.service.exception.RbacValidationException;

import lpr_mx.AllocationGroupResponseV1;
import lpr_mx.AllocationGroupV1;

@ExtendWith(MockitoExtension.class)
public class AllocationGroupControllerTest {

    @Mock
    private CreateAllocationGroupDomainService createAllocationGroupDomainService;

    @Mock
    private CMDSLoggerUtils loggerUtil;

    @Mock
    private LPRCommonUtils commonUtils;

    @InjectMocks
    private AllocationGroupController allocationGroupController;

    private AllocationGroupV1 allocationGroupV1;
    private AllocationGroupResponseV1 allocationGroupResponseV1;
    private HttpHeaders httpHeaders;

    @BeforeEach
    void setUp() {
        allocationGroupV1 = new AllocationGroupV1();
        allocationGroupV1.setAllocationGroupName("Test Group");
        allocationGroupV1.setEffectiveFromDate("2025-03-20");
        allocationGroupV1.setEffectiveToDate("2025-06-14");

        allocationGroupResponseV1 = new AllocationGroupResponseV1();
        allocationGroupResponseV1.setAllocationGroupUuid(UUID.fromString("b2885ba0-cb85-4629-a0af-1db25f3d7154"));
        allocationGroupResponseV1.setAllocationGroupId(1);
        allocationGroupResponseV1.setAllocationGroupName("Test Group");
        allocationGroupResponseV1.setEffectiveFromDate("2025-03-20");
        allocationGroupResponseV1.setEffectiveToDate("2025-06-14");

        httpHeaders = new HttpHeaders();
        httpHeaders.add("x-access-token", "valid-token");
        httpHeaders.add("correlationid", UUID.randomUUID().toString());
        httpHeaders.add("connectionid", "connection-id");

        // Clear ThreadLocal before running a test
        ThreadLocalHeaderContext.clear();
        ThreadLocalAuditContext.clear();
    }

    @AfterEach
    void tearDown() {
        // Clean up ThreadLocal values after each test
        ThreadLocalHeaderContext.clear();
        ThreadLocalAuditContext.clear();
    }

    @Test
    public void testCreateAllocationGroup_Success() throws RbacValidationException {
        when(createAllocationGroupDomainService.addAllocationGroup(eq(allocationGroupV1), eq(httpHeaders)))
                .thenReturn(allocationGroupResponseV1);
        when(commonUtils.getPartnerCode("valid-token")).thenReturn("partner-code");

        ResponseEntity<AllocationGroupResponseV1> response =
                allocationGroupController.createAllocationGroup(allocationGroupV1, httpHeaders);

        assertNotNull(response);
        assertEquals(HttpStatus.OK, response.getStatusCode());
        assertEquals(allocationGroupResponseV1, response.getBody());

        // Verify logger initialization
        ArgumentCaptor<String> correlationIdCaptor = ArgumentCaptor.forClass(String.class);
        verify(loggerUtil).initializeMDCContext(anyString(), eq("Allocation Group Unit"), correlationIdCaptor.capture());
        assertEquals(httpHeaders.getFirst("correlationid"), correlationIdCaptor.getValue());

        verify(createAllocationGroupDomainService).addAllocationGroup(allocationGroupV1, httpHeaders);

        // Verify header context initialization
        assertNotNull(ThreadLocalHeaderContext.getContext());
        assertEquals(UUID.fromString(httpHeaders.getFirst("correlationid")), ThreadLocalHeaderContext.getContext().getCorrelationId());
        assertEquals("valid-token", ThreadLocalHeaderContext.getContext().getXaccessToken());
        assertEquals("connection-id", ThreadLocalHeaderContext.getContext().getConnectionId());
        assertEquals("partner-code", ThreadLocalHeaderContext.getContext().getPartnerCode());

        // Verify audit context initialization
        assertNotNull(ThreadLocalAuditContext.getContext());
        assertEquals(ThreadLocalHeaderContext.getContext().getCorrelationId(), ThreadLocalAuditContext.getContext().getCausedByCorrelationId());
    }

    @Test
    public void testCreateAllocationGroup_ThrowsException() throws RbacValidationException {
        RbacValidationException exception = new RbacValidationException("RBAC Error", new RuntimeException("RBAC validation error occurred"));
        when(createAllocationGroupDomainService.addAllocationGroup(eq(allocationGroupV1), eq(httpHeaders)))
                .thenThrow(exception);
        when(commonUtils.getPartnerCode("valid-token")).thenReturn("partner-code");

        RbacValidationException thrownException = assertThrows(RbacValidationException.class, () ->
                allocationGroupController.createAllocationGroup(allocationGroupV1, httpHeaders));

        assertEquals("RBAC Error", thrownException.getMessage());
        assertEquals("RBAC validation error occurred", thrownException.getCause().getMessage());

        verify(loggerUtil).initializeMDCContext(anyString(), eq("Allocation Group Unit"), anyString());
        verify(createAllocationGroupDomainService).addAllocationGroup(allocationGroupV1, httpHeaders);

        // Verify header context initialization
        assertNotNull(ThreadLocalHeaderContext.getContext());
        assertEquals(UUID.fromString(httpHeaders.getFirst("correlationid")), ThreadLocalHeaderContext.getContext().getCorrelationId());
        assertEquals("valid-token", ThreadLocalHeaderContext.getContext().getXaccessToken());
        assertEquals("connection-id", ThreadLocalHeaderContext.getContext().getConnectionId());
        assertEquals("partner-code", ThreadLocalHeaderContext.getContext().getPartnerCode());

        // Verify audit context initialization
        assertNotNull(ThreadLocalAuditContext.getContext());
        assertEquals(ThreadLocalHeaderContext.getContext().getCorrelationId(), ThreadLocalAuditContext.getContext().getCausedByCorrelationId());
    }
}
